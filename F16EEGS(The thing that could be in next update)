    } catch (error) {
      configuredMissiles = { ...DEFAULT_MISSILE_LOADOUT };
      toast = { text: 'LOADOUT SETTINGS COULD NOT BE READ', until: performance.now() + 3000 };
    }
    missileAmmo = { ...configuredMissiles };
