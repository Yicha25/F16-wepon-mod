  function stopAASimulation(message = 'A/A SIM STOPPED') {
    const npcIds = new Set(aaSimulation.npcs.map(npc => npc.id));
    aaSimulation.active = false;
    aaSimulation.npcs = [];
    missiles = missiles.filter(missile => !npcIds.has(missile.targetId));
