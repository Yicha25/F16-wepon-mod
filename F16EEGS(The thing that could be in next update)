          mul(axes[1], (Math.random() - 0.5) * 12)),
        size: 1 + Math.random() * 1.5,
      });
    }
    for (let i = 0; i < 3; i++) {
      countermeasures.push({
        type: 'flare', t0: now, life: 1.8, sequence,
        origin, invOrigin,
        offset: add(mul(axes[0], -7), mul(axes[1], (Math.random() - 0.5) * 5)),
        velocity: add(mul(axes[0], -18 - Math.random() * 8),
          [0, 0, -3 - Math.random() * 4]),
